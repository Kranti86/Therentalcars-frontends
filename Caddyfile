# Railway (Railpack) static hosting for the Therentalcars online app.
# Based on Railpack's default static-site Caddyfile, plus what vercel.json did:
#   "/"      -> serves online.html (the booking app)
#   "/about" -> serves about.html  (clean URLs; *.html still works too)
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}


	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Allows the backend API, PayPal card fields, Google tags and Clarity (all https).
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *; frame-ancestors 'self'; base-uri 'self'"
		-Server
	}

	root * .
	encode gzip zstd

	# Railway's health check. Its own handle block: inside the catch-all below it would 404,
	# and Railway would refuse to deploy.
	handle /health {
		respond 200
	}

	# SEO location pages are rendered by the backend but live on this domain.
	# X-TRC-Site tells the backend it's being served here, so the pages are indexable.
	handle /car-rental* {
		reverse_proxy https://carfinder-backend-production-89e82f29.up.railway.app {
			header_up X-TRC-Site main
		}
	}

	handle {
		# Home page = the booking app (same as the vercel.json rewrite)
		rewrite / /online.html

		# Clean URLs: /about -> about.html, /online -> online.html
		try_files {path} {path}.html {path}/index.html

		file_server {
			# never serve config/docs files
			hide .git .env* Caddyfile Staticfile vercel.json *.md
		}
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
